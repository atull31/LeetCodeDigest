
class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        int d=0;
        int[] res = new int[seq.length()];
        for(int i=0;i<seq.length();i++){
            if(seq.charAt(i)=='('){
                d++;
                if(d%2==0){
                    res[i] = 0;
                }else{
                    res[i]=1;
                }
            }else{
                if(d%2==0){
                    res[i]=0;
                }else{
                    res[i]=1;
                }
                d--;
            }
        }
        return res;
    }
}
